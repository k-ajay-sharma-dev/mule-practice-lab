rules_version = '2';

// Each signed-in person can read and write only their own progress, and nothing else exists.
// Paste this into Firebase console → Firestore Database → Rules (see DEPLOY.md).
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{collection}/{docId} {
      allow read: if request.auth != null && request.auth.uid == uid
        && collection in ['progress', 'state'];
      allow write: if request.auth != null && request.auth.uid == uid
        && collection in ['progress', 'state']
        && request.resource.data.keys().hasOnly(['entry', 'value', 'updatedAt', 'syncedAt']);
    }
  }
}
